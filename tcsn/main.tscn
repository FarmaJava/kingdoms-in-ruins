[sub_resource type="GDScript" id="GDScript_tt8nk"]
script/source = "extends Node2D

@export var enemy_scene: PackedScene
@export var spawn_distance: float = 700.0  # un poco más que la mitad de tu pantalla

# Dificultad progresiva
@export var difficulty_interval: float = 20.0       # cada cuántos segundos sube el ritmo
@export var wait_decay: float = 0.92                # multiplica el tiempo entre oleadas
@export var min_wait_time: float = 0.5              # el spawn nunca va más rápido que esto
@export var extra_enemy_interval: float = 60.0      # +1 enemigo por oleada cada tanto
@export var max_enemies_per_spawn: int = 6
@export var health_growth_per_minute: float = 0.15  # +15% de vida por minuto
@export var max_enemies_alive: int = 150

@onready var player: CharacterBody2D = $Player
@onready var spawn_timer: Timer = $SpawnTimer

var base_wait_time: float

func _ready() -> void:
	base_wait_time = spawn_timer.wait_time
	spawn_timer.timeout.connect(_on_spawn_timer_timeout)

func _on_spawn_timer_timeout() -> void:
	_update_difficulty()

	var t: float = player.survival_time
	var count := mini(1 + int(t / extra_enemy_interval), max_enemies_per_spawn)

	for i in count:
		if get_tree().get_nodes_in_group(\"enemies\").size() >= max_enemies_alive:
			return
		_spawn_enemy(t)

func _update_difficulty() -> void:
	var steps := int(player.survival_time / difficulty_interval)
	spawn_timer.wait_time = maxf(min_wait_time, base_wait_time * pow(wait_decay, steps))

func _spawn_enemy(elapsed: float) -> void:
	var enemy := enemy_scene.instantiate()
	var minutes := elapsed / 60.0
	enemy.max_health *= 1.0 + minutes * health_growth_per_minute
	add_child(enemy)
	enemy.global_position = _get_spawn_position()

func _get_spawn_position() -> Vector2:
	var pos := Vector2.ZERO
	for i in 10:
		pos = player.global_position + Vector2.from_angle(randf() * TAU) * spawn_distance
		if player.map_rect.has_point(pos):
			return pos
	return pos.clamp(player.map_rect.position, player.map_rect.end)
"

